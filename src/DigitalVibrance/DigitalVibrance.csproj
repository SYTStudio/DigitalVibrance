<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DigitalVibrance</AssemblyName>
    <RootNamespace>DigitalVibrance</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Digital Vibrance</Product>
    <Company>Digital Vibrance</Company>
    <Description>Per-game colour control that runs on top of the driver.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinForms is only referenced for the tray icon; DPI is owned by the WPF manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Embedded so a built-in language can never go missing at runtime. Extra or corrected
         packs can still be dropped into %AppData%\DigitalVibrance\Languages. -->
    <EmbeddedResource Include="Localization\Languages\*.json" />
  </ItemGroup>

</Project>
