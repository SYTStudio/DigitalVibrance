<UserControl x:Class="DigitalVibrance.Views.SliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,14">
        <Grid Margin="0,0,0,5">
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="12.5" Foreground="{StaticResource Text}"/>
            <TextBlock HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{Binding ValueBrush, ElementName=Root}">
                <Run Text="{Binding Value, ElementName=Root, StringFormat={}{0:0}}"/><Run Text="{Binding Unit, ElementName=Root, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <Slider Style="{StaticResource DvSlider}"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Caption}"
                   Margin="0,3,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasHint, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
